# Public base URL of the app, used for the OAuth callback (e.g. http://localhost:3000)
APP_URL=http://localhost:3000

# Anthropic API key (server-side only)
ANTHROPIC_API_KEY=

# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret for encrypting the session cookie, at least 32 characters (e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Comma-separated GitHub logins allowed to sign in
ALLOWED_GITHUB_LOGINS=

# Set to 1 to use in-process fakes for Anthropic, GitHub and OAuth (e2e tests only; refused in production)
KEEL_FAKE_EXTERNALS=0
